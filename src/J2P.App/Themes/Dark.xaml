<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#1E2227</Color>
    <Color x:Key="PanelBackgroundColor">#262B31</Color>
    <Color x:Key="ForegroundColor">#E6E9ED</Color>
    <Color x:Key="SecondaryForegroundColor">#9AA3AE</Color>
    <Color x:Key="BorderColor">#3A414A</Color>
    <Color x:Key="AccentColor">#4C9EE8</Color>
    <Color x:Key="AccentForegroundColor">#10151A</Color>
    <Color x:Key="RowAltColor">#2B3138</Color>
    <Color x:Key="HoverColor">#333A42</Color>
    <Color x:Key="SuccessColor">#4CC38A</Color>
    <Color x:Key="ErrorColor">#F26D5F</Color>
    <Color x:Key="WarningColor">#E5B567</Color>
    <Color x:Key="OverlayColor">#B31E2227</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

</ResourceDictionary>
