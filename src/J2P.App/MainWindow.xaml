<Window x:Class="J2P.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:J2P.App.ViewModels"
        xmlns:conv="clr-namespace:J2P.App.Converters"
        Title="J2P — Jw_cad 一括PDF変換"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="560"
        FontFamily="Yu Gothic UI, Meiryo UI, MS PGothic"
        FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:IndexMatchConverter x:Key="IndexMatch" />
    </Window.Resources>

    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ツールバー -->
            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10" LastChildFill="False">
                <Button Content="ファイル追加" Command="{Binding AddFilesCommand}" Margin="0,0,6,0" />
                <Button Content="フォルダ追加" Command="{Binding AddFolderCommand}" Margin="0,0,6,0" />
                <Button Content="選択を除外" Command="{Binding RemoveSelectedCommand}" Margin="0,0,6,0" />
                <Button Content="クリア" Command="{Binding ClearFilesCommand}" Margin="0,0,12,0" />
                <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="200" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding FileCountText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Style="{StaticResource SecondaryText}" />
                <CheckBox Content="ダークモード" DockPanel.Dock="Right" VerticalAlignment="Center"
                          IsChecked="{Binding DarkMode}" />
            </DockPanel>

            <!-- ファイル一覧 -->
            <DataGrid Grid.Row="1" Grid.Column="0"
                      ItemsSource="{Binding FilesView}"
                      SelectedItem="{Binding SelectedFile}"
                      AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="180" />
                    <DataGridTextColumn Header="フォルダ" Binding="{Binding Folder}" Width="220" />
                    <DataGridTextColumn Header="更新日時"
                                        Binding="{Binding Modified, StringFormat=yyyy/MM/dd HH:mm}" Width="120" />
                    <DataGridTextColumn Header="用紙" Binding="{Binding PaperSize}" Width="55" />
                    <DataGridTextColumn Header="縮尺" Binding="{Binding Scale}" Width="65" />
                    <DataGridTextColumn Header="出力PDF名" Binding="{Binding OutputName}" Width="170" />
                    <DataGridTextColumn Header="状態" Binding="{Binding StatusText}" Width="105">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Converting">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 設定パネル -->
            <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="出力設定" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                        <TextBlock Text="出力先フォルダ" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <RadioButton Content="元ファイルと同じフォルダ" GroupName="dest"
                                     IsChecked="{Binding DestinationIndex,
                                        Converter={StaticResource IndexMatch}, ConverterParameter=0}" />
                        <RadioButton Content="別フォルダへ保存" GroupName="dest"
                                     IsChecked="{Binding DestinationIndex,
                                        Converter={StaticResource IndexMatch}, ConverterParameter=1}" />
                        <DockPanel Margin="18,2,0,0"
                                   IsEnabled="{Binding IsFolderDestination}">
                            <Button Content="参照" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,3"
                                    Command="{Binding BrowseDestinationFolderCommand}" />
                            <TextBox Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Text="出力ファイル名" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ComboBox SelectedIndex="{Binding NamingIndex}">
                            <ComboBoxItem Content="元ファイル名" />
                            <ComboBoxItem Content="元ファイル名_PDF" />
                            <ComboBoxItem Content="元ファイル名_日付" />
                            <ComboBoxItem Content="任意の命名ルール" />
                        </ComboBox>
                        <TextBox Margin="0,4,0,0"
                                 Text="{Binding CustomPattern, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsCustomNaming, Converter={StaticResource BoolToVis}}"
                                 ToolTip="{}{name}=元ファイル名 {date}=日付 {time}=時刻" />

                        <TextBlock Text="同名ファイルがある場合" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ComboBox SelectedIndex="{Binding CollisionIndex}">
                            <ComboBoxItem Content="上書き" />
                            <ComboBoxItem Content="連番を付ける" />
                            <ComboBoxItem Content="スキップ" />
                        </ComboBox>

                        <TextBlock Text="PDF設定" FontWeight="Bold" FontSize="14" Margin="0,16,0,8" />

                        <TextBlock Text="印刷範囲" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox SelectedIndex="{Binding PrintAreaIndex}"
                                  ToolTip="Jw_cadで設定した印刷範囲を再現するには「ファイルの印刷設定」を選びます">
                            <ComboBoxItem Content="ファイルの印刷設定に従う" />
                            <ComboBoxItem Content="用紙全体" />
                            <ComboBoxItem Content="図形全体にフィット" />
                        </ComboBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="用紙サイズ" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox SelectedIndex="{Binding PaperIndex}">
                                    <ComboBoxItem Content="自動" />
                                    <ComboBoxItem Content="A4" />
                                    <ComboBoxItem Content="A3" />
                                    <ComboBoxItem Content="A2" />
                                    <ComboBoxItem Content="A1" />
                                    <ComboBoxItem Content="A0" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="用紙方向" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox SelectedIndex="{Binding OrientationIndex}">
                                    <ComboBoxItem Content="自動" />
                                    <ComboBoxItem Content="縦" />
                                    <ComboBoxItem Content="横" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="印刷倍率" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <DockPanel>
                            <TextBox Width="60" DockPanel.Dock="Right" Margin="4,0,0,0"
                                     Text="{Binding CustomMagnification, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsCustomMagnification, Converter={StaticResource BoolToVis}}"
                                     ToolTip="%" />
                            <ComboBox SelectedIndex="{Binding MagnificationIndex}">
                                <ComboBoxItem Content="自動" />
                                <ComboBoxItem Content="100%" />
                                <ComboBoxItem Content="70%" />
                                <ComboBoxItem Content="50%" />
                                <ComboBoxItem Content="任意 (%)" />
                            </ComboBox>
                        </DockPanel>

                        <CheckBox Content="白黒で出力（カラーを使わない）" Margin="0,10,0,0"
                                  IsChecked="{Binding BlackAndWhite}" />

                        <TextBlock Text="オプション" FontWeight="Bold" FontSize="14" Margin="0,16,0,8" />
                        <CheckBox Content="サブフォルダも処理する" IsChecked="{Binding IncludeSubfolders}" />
                        <CheckBox Content="更新されたファイルのみ変換" IsChecked="{Binding OnlyUpdated}" />
                        <CheckBox Content="変換後に保存先フォルダを開く" IsChecked="{Binding OpenFolderAfter}" />
                        <CheckBox Content="変換後にPDFを開く" IsChecked="{Binding OpenPdfAfter}" />
                        <CheckBox Content="PDFを1つに結合する" IsChecked="{Binding MergeToSinglePdf}" />
                        <CheckBox Content="変換前に確認画面を表示する" IsChecked="{Binding ConfirmBeforeConvert}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 下部バー -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentFileText}" Style="{StaticResource SecondaryText}" />
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Margin="0,3,12,3" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ログ保存" Command="{Binding SaveLogCommand}" Margin="0,0,6,0" />
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}"
                            IsEnabled="{Binding IsConverting}" Margin="0,0,6,0" />
                    <Button Content="中止" Command="{Binding CancelConversionCommand}"
                            IsEnabled="{Binding IsConverting}" Margin="0,0,12,0" />
                    <Button Content="変換開始" Style="{StaticResource AccentButton}"
                            Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                            Padding="24,8" FontSize="14" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 確認オーバーレイ -->
        <Grid Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding ShowConfirmOverlay, Converter={StaticResource BoolToVis}}">
            <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="24">
                <StackPanel MinWidth="420">
                    <TextBlock Text="変換内容の確認" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="キャンセル" Command="{Binding ConfirmCancelCommand}" Margin="0,0,8,0" />
                        <Button Content="変換を開始" Style="{StaticResource AccentButton}"
                                Command="{Binding ConfirmProceedCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 結果サマリオーバーレイ -->
        <Grid Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding ShowSummaryOverlay, Converter={StaticResource BoolToVis}}">
            <Border MaxWidth="640" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="24">
                <StackPanel MinWidth="480">
                    <TextBlock Text="{Binding SummaryTitle}" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="ログ保存" Command="{Binding SaveLogCommand}" Margin="0,0,8,0" />
                        <Button Content="保存先を開く" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="閉じる" Style="{StaticResource AccentButton}"
                                Command="{Binding CloseSummaryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
